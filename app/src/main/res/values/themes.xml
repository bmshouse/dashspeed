<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose apps use DashSpeedTheme (MaterialTheme) at runtime.
        This XML theme is only needed for the activity window background
        and to suppress the default title bar before Compose takes over.
    -->
    <style name="Theme.DashSpeed" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
